# Copy to .env.local and fill in.

# Session-cookie JWT secret. Generate one:  openssl rand -base64 32
AUTH_SECRET=

# --- Supabase (needed for deploy; optional locally) ---
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, uploaded map images
# go to Supabase Storage instead of local disk (lib/storage.ts).
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service-role key — server-only secret, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for uploaded maps (default: maps)
SUPABASE_STORAGE_BUCKET=maps

# --- Database (Supabase Postgres; the port is planned, see DEPLOY.md) ---
# Not read yet — local dev still runs on SQLite at data/dnd-hub.db.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
