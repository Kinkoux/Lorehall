# Copy to .env.local and fill in.

# Session-cookie JWT secret. Generate one:  openssl rand -base64 32
AUTH_SECRET=

# --- Supabase (needed for deploy; optional locally) ---
# When SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are set, uploaded map images
# go to Supabase Storage instead of local disk (lib/storage.ts).
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Secret key (new dashboards: "API Keys" -> secret key, sb_secret_...;
# legacy projects: service_role). Server-only — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Private storage bucket for uploaded maps (default: maps)
SUPABASE_STORAGE_BUCKET=maps

# --- Outgoing mail (optional) ---
# Confirmation links and password resets. With any of these missing the app
# still registers accounts and still saves addresses — it just sends nothing,
# and the dashboard keeps offering a "send it again" button that no-ops.
# Port 465 is used as implicit TLS; 587/25 start plain and upgrade.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# What the messages are sent as, e.g. Lorehall <no-reply@yourdomain.tld>
EMAIL_FROM=
# Absolute base URL the mailed links point at (no trailing slash).
# Defaults to https://lorehall.vercel.app when unset.
APP_URL=http://localhost:3000

# --- Database (Supabase Postgres) — REQUIRED ---
# Dashboard -> Connect -> Transaction pooler URI (port 6543), replace the
# [YOUR-PASSWORD] placeholder (brackets included) with your DB password.
# After filling in, create the schema once with: npm run db:bootstrap
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
